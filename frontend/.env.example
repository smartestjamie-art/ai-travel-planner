# If the frontend is also running on a remote server, do not use 127.0.0.1 here —
# use a backend address reachable from the browser, e.g. the server's public IP or a mapped domain.
VITE_API_BASE_URL=http://YOUR_SERVER_HOST:8000

# Amap (Gaode Maps) JavaScript API Key.
# Note: this must be the frontend JS API key, not the backend web service key.
VITE_AMAP_JS_KEY=
