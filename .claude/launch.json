{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app.api.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "redis",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["run", "--rm", "--name", "tripplanner-redis", "-p", "6379:6379", "redis:7"],
      "port": 6379
    }
  ]
}
